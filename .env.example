# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings -> API Keys). Os dois valores são PÚBLICOS: vão dentro do app.
# NUNCA coloque aqui a "secret key" / service role.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Endereço da versão web (usado no link de "redefinir senha" enviado por e-mail)
EXPO_PUBLIC_WEB_URL=https://dashboard-financeiro.expo.app
